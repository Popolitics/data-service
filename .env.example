DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/data_service

# Clé PUBLIQUE d'auth-service, pour vérifier ses JWT (RS256). Jamais la clé
# privée : data-service ne signe rien, il ne fait que valider. Doit être
# identique à JWT_PUBLIC_KEY côté auth-service.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
